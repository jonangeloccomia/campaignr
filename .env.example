# Copy to .env.local and fill in. All variables are required (validated in config/env.ts).

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/campaignr

# Auth.js secret — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Resend (magic-link / transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Anthropic (AI template generation)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
